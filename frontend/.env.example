# ---------------------------------------------------------------------------
# Frontend environment configuration
# Copy this file to `.env` and point VITE_API_URL at the Express backend.
# The base URL is read exclusively from this variable (src/services/api.js) —
# no localhost or hard-coded host appears anywhere in the application code.
# ---------------------------------------------------------------------------

# Base URL of the Express analysis API (no trailing slash), e.g.:
#   http://localhost:3000/api        (Express default port)
#   https://api.your-domain.org/api  (deployed backend)
VITE_API_URL=http://localhost:3000/api

# Expected Express API contract consumed by this frontend:
#
#   GET  /health      -> { "status": "ok" }
#   GET  /model-info  -> { "model_version": "1.0.0", "algorithms": { ... },
#                          "trained_at": "ISO-8601" }
#   POST /predict     (multipart/form-data: voice, handwriting, gait files)
#                 ->  {
#                       "model_version": "1.0.0",
#                       "timestamp": "ISO-8601",
#                       "overall_probability": 0.72,
#                       "risk_band": "high",
#                       "modalities": {
#                         "voice":       { "available": true, "probability": 0.81, "contribution": 0.38 },
#                         "handwriting": { "available": true, "probability": 0.70, "contribution": 0.33 },
#                         "gait":        { "available": false, "probability": null, "contribution": null }
#                       },
#                       "fusion": { "method": "TabNet", "probability": 0.72, "contribution": 0.29 },
#                       "explanations": {
#                         "voice":       [{ "feature": "MDVP:Jitter(%)", "shap": 0.14, "value": 0.015 }],
#                         "handwriting": [{ "feature": "RMS", "shap": 0.09, "value": 21.4 }],
#                         "gait":        [{ "feature": "stride_cv", "shap": 0.11, "value": 0.031 }],
#                         "multimodal":  [{ "feature": "voice.probability", "shap": 0.21, "value": 0.81 }]
#                       }
#                     }
#
# All explanation values displayed in the UI come from the API responses —
# the frontend never fabricates SHAP values, probabilities, or metrics.
